
@model DemoMVC.Models.Student

@{
    ViewData["Title"] = "Sửa sinh viên";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-warning py-3">
                    <h1 class="h4 fw-bold mb-0">Cập nhật thông tin sinh viên</h1>
                </div>

                <div class="card-body p-4">
                    <form asp-controller="Student"
                          asp-action="Edit"
                          asp-route-id="@Model.Id"
                          method="post">

                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div asp-validation-summary="All"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="StudentCode" class="form-label">
                                Mã sinh viên
                            </label>
                            <input asp-for="StudentCode"
                                   class="form-control"
                                   readonly />
                        </div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label">
                                Họ và tên
                            </label>
                            <input asp-for="FullName"
                                   class="form-control" />
                            <span asp-validation-for="FullName"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Address" class="form-label">
                                Địa chỉ
                            </label>
                            <input asp-for="Address"
                                   class="form-control" />
                            <span asp-validation-for="Address"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="University" class="form-label">
                                Trường đại học
                            </label>
                            <input asp-for="University"
                                   class="form-control" />
                            <span asp-validation-for="University"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="FacultyId" class="form-label">
                                Khoa
                            </label>
                            <select asp-for="FacultyId"
                                    asp-items="ViewBag.Faculties"
                                    class="form-select">
                                <option value="">-- Chọn khoa --</option>
                            </select>
                            <span asp-validation-for="FacultyId"
                                  class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning">
                                Lưu thay đổi
                            </button>

                            <a asp-controller="Student"
                               asp-action="Index"
                               class="btn btn-secondary">
                                Hủy
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
