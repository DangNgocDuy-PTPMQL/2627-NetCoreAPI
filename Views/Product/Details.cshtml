@model DemoMVC.Models.Product

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-info text-white py-3">
                    <h4 class="mb-0">
                        Chi tiết sản phẩm
                    </h4>
                </div>

                <div class="card-body p-4">

                    <dl class="row">

                        <dt class="col-sm-4">
                            ID
                        </dt>

                        <dd class="col-sm-8">
                            @Model.Id
                        </dd>

                        <dt class="col-sm-4">
                            Tên sản phẩm
                        </dt>

                        <dd class="col-sm-8">
                            @Model.Name
                        </dd>

                        <dt class="col-sm-4">
                            Giá
                        </dt>

                        <dd class="col-sm-8 text-danger fw-bold">
                            @(Model.Price?.ToString("N0") ?? "0") VND
                        </dd>

                        <dt class="col-sm-4">
                            Danh mục
                        </dt>

                        <dd class="col-sm-8">
                            <span class="badge bg-secondary">
                                @Model.Category
                            </span>
                        </dd>

                    </dl>

                    <hr />

                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-warning">
                        Sửa
                    </a>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Quay lại
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>