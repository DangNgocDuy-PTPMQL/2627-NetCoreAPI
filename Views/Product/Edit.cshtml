@model DemoMVC.Models.Product

@{
    ViewData["Title"] = "Sửa sản phẩm";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-warning py-3">

                    <h4 class="mb-0">
                        Sửa sản phẩm
                    </h4>

                </div>

                <div class="card-body p-4">

                    <form asp-action="Edit">

                        <input type="hidden"
                               asp-for="Id" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">

                            <label asp-for="Name"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Name"
                                   class="form-control" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Price"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Price"
                                   class="form-control"
                                   type="number"
                                   min="0" />

                            <span asp-validation-for="Price"
                                  class="text-danger">
                            </span>

                        </div>
<div class="mb-3">
    <label asp-for="Quantity" class="form-label fw-bold">
        Số lượng
    </label>

    <input asp-for="Quantity"
           class="form-control"
           placeholder="Nhập số lượng sản phẩm" />

    <span asp-validation-for="Quantity"
          class="text-danger">
    </span>
</div>
                        <div class="mb-4">

                            <label asp-for="Category"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Category"
                                   class="form-control" />

                            <span asp-validation-for="Category"
                                  class="text-danger">
                            </span>

                        </div>

                        <button type="submit"
                                class="btn btn-warning">
                            Lưu thay đổi
                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Quay lại
                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}