@model DemoMVC.Models.Product

@{
    ViewData["Title"] = "Thêm sản phẩm";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0">
                        Thêm sản phẩm
                    </h4>
                </div>

                <div class="card-body p-4">

                    <form asp-action="Create">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">

                            <label asp-for="Name"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Nhập tên sản phẩm" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Price"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Price"
                                   class="form-control"
                                   type="number"
                                   min="0"
                                   placeholder="Nhập giá sản phẩm" />

                            <span asp-validation-for="Price"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Category"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Category"
                                   class="form-control"
                                   placeholder="Ví dụ: Thiết bị điện" />

                            <span asp-validation-for="Category"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">
                                Lưu sản phẩm
                            </button>

                            <a asp-action="Index"
                               class="btn btn-secondary">
                                Quay lại
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}