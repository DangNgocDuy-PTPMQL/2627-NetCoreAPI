@model DemoMVC.Models.Product

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-primary text-white">
                    <h2 class="mb-0">Thêm sản phẩm</h2>
                </div>

                <div class="card-body p-4">

                    <form asp-action="Create" method="post">

                        <!-- Tên sản phẩm -->
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold">
                                Tên sản phẩm
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Nhập tên sản phẩm" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- Giá -->
                        <div class="mb-3">
                            <label asp-for="Price" class="form-label fw-bold">
                                Giá
                            </label>

                            <input asp-for="Price"
                                   class="form-control"
                                   placeholder="Nhập giá sản phẩm" />

                            <span asp-validation-for="Price"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- Số lượng -->
                        <div class="mb-3">
                            <label asp-for="Quantity" class="form-label fw-bold">
                                Số lượng
                            </label>

                            <input asp-for="Quantity"
                                   class="form-control"
                                   placeholder="Nhập số lượng sản phẩm" />

                            <span asp-validation-for="Quantity"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- Danh mục -->
                        <div class="mb-3">
                            <label asp-for="Category" class="form-label fw-bold">
                                Danh mục
                            </label>

                            <input asp-for="Category"
                                   class="form-control"
                                   placeholder="Ví dụ: Thiết bị điện" />

                            <span asp-validation-for="Category"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mt-4">
                            <button type="submit"
                                    class="btn btn-primary">
                                <i class="bi bi-save"></i>
                                Lưu sản phẩm
                            </button>

                            <a asp-action="Index"
                               class="btn btn-secondary">
                                Quay lại
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}